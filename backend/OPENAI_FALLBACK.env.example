# Pruvs v6.7 - OpenAI fallback configuration
# Never commit a real OPENAI_API_KEY.

OPENAI_API_KEY=replace_in_render_only

# Azure remains primary; OpenAI is used only on Azure OCR failure.
OPENAI_RECEIPT_FALLBACK_ENABLED=true

# Azure Translator remains primary; OpenAI is used only if Azure translation
# is missing/unavailable/errors.
OPENAI_TRANSLATION_FALLBACK_ENABLED=true

OPENAI_RECEIPT_MODEL=gpt-6-luna
OPENAI_TRANSLATION_MODEL=gpt-6-luna
OPENAI_RECEIPT_IMAGE_DETAIL=high
OPENAI_RECEIPT_PDF_DETAIL=high
OPENAI_TIMEOUT_SECONDS=60
OPENAI_RECEIPT_MAX_OUTPUT_TOKENS=5000
