# Local app
WHATSAPP_ENABLED=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./pruvio.db
PRUVIO_STORAGE_SECRET=replace-with-a-long-random-value

# OTP
OTP_SECRET=replace-with-a-long-random-value
OTP_CODE_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Local testing only. Set false in Render/production.
OTP_DEBUG_RETURN_CODE=true

# Phone OTP: mock locally, twilio when configured
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email OTP: configure SMTP; local testing can rely on OTP_DEBUG_RETURN_CODE
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_LOCALE=auto

# Translation
ENABLE_RECEIPT_TRANSLATION=true
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=northeurope

# Legal/support placeholders — replace before production
PRUVIO_LEGAL_ENTITY_NAME=[LEGAL ENTITY NAME]
PRUVIO_LEGAL_ADDRESS=[REGISTERED ADDRESS]
PRUVIO_LEGAL_CONTACT_EMAIL=support@pruvio.app
PRUVIO_SUPPORT_EMAIL=support@pruvio.app

# Passkeys / WebAuthn
PASSKEY_ENABLED=true
# Local example: 127.0.0.1 with matching PUBLIC_BASE_URL.
# Render example: pruvio.onrender.com (hostname only, no https://)
PASSKEY_RP_ID=127.0.0.1
PASSKEY_RP_NAME=Pruvio
PASSKEY_ORIGIN=http://127.0.0.1:8000
# Secret used to derive a stable opaque WebAuthn user handle. Use a long random value in Render.
PASSKEY_USER_HANDLE_SECRET=replace-with-a-long-random-value

# Developer-only Authenticator (TOTP) debug login
DEV_TOTP_ENABLED=false
# Comma-separated, verified developer emails only
DEV_TOTP_ALLOWED_EMAILS=
# Base32 secret generated once and stored only in Render/local environment
DEV_TOTP_SECRET=
DEV_TOTP_ISSUER=Pruvio Developer

# Admin API (required for GET /users/ and POST /users/)
PRUVIO_ADMIN_API_KEY=replace-with-a-long-random-admin-key
