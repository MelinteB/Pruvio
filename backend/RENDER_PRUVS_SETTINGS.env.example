# Apply after pruvs.io HTTPS and auth.pruvs.io Resend verification succeed.
# This file contains no secrets. Add RESEND_API_KEY privately in Render.
# Merge these values into existing settings; preserve database/storage/OTP/Azure secrets.
PUBLIC_BASE_URL=https://pruvs.io
CANONICAL_REDIRECT_ENABLED=true
PASSKEY_ENABLED=true
PASSKEY_RP_ID=pruvs.io
PASSKEY_RP_NAME=Pruvs
PASSKEY_ORIGIN=https://pruvs.io
EMAIL_PROVIDER=resend
EMAIL_FROM="Pruvs <verify@auth.pruvs.io>"
OTP_DEBUG_RETURN_CODE=false
DEV_TOTP_ENABLED=false
WHATSAPP_ENABLED=false
WHATSAPP_OTP_ENABLED=false
LOCAL_OCR_ENABLED=false
