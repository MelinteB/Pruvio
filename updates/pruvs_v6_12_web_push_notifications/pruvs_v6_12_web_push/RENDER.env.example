# Generate a real key pair using scripts/generate_vapid.py. Keep it across deploys.
PRUVS_PUSH_ENABLED=true
PRUVS_PUSH_WORKER_ENABLED=true
PRUVS_VAPID_PUBLIC_KEY=GENERATED_PUBLIC_KEY
PRUVS_VAPID_PRIVATE_KEY=GENERATED_PRIVATE_KEY
PRUVS_VAPID_SUBJECT=mailto:YOUR_REAL_CONTACT_EMAIL
PUBLIC_BASE_URL=https://pruvs.io
# Preserve existing DATABASE_URL, PRUVIO_STORAGE_SECRET and email settings.
# Email fallback uses the existing EMAIL_PROVIDER/RESEND or SMTP configuration.
